{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The only window. It may receive LineCaller events and call LineCaller's own commands, nothing else (no file system, shell, HTTP or opener access).",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-bootstrap",
    "allow-save-settings",
    "allow-connect",
    "allow-disconnect",
    "allow-dial",
    "allow-accept-call",
    "allow-set-audio",
    "allow-drop-line",
    "allow-set-audio-lock",
    "allow-set-incoming-block",
    "allow-refresh-lines",
    "allow-clear-recents",
    "allow-simulate-incoming-call"
  ]
}
